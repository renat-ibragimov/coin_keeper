# Copy to .env and fill in. Placeholders only — never commit real values.
# The full reference is docs/infra.md.

# --- database, cache ---
DATABASE_URL=postgresql+asyncpg://coinkeeper:<password>@postgres:5432/coinkeeper
REDIS_URL=redis://redis:6379/0

# Used by docker compose to initialise the postgres container.
POSTGRES_USER=coinkeeper
POSTGRES_PASSWORD=<password>
POSTGRES_DB=coinkeeper

# --- object storage ---
S3_ENDPOINT=http://minio:9000
# Set only on the server, where the browser cannot resolve S3_ENDPOINT: signs
# presigned GET URLs against this host instead (docs/media.md).
# Leave empty locally — S3_ENDPOINT already resolves from the host.
S3_PUBLIC_ENDPOINT=https://<domain>/media
S3_BUCKET=coinkeeper-media
S3_ACCESS_KEY=<access-key>
S3_SECRET_KEY=<secret-key>

# --- application ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=<random-secret>
DOMAIN=<domain>
PUBLIC_BASE_URL=https://<domain>
CORS_ORIGINS=https://<domain>
# Emergency switch only; open registration is the normal state (docs/auth.md).
ALLOW_REGISTRATION=true
# Set to false only when serving over plain http locally.
COOKIE_SECURE=true
LOG_LEVEL=INFO

# --- mail ---
# console = write the message to the log (local development, tests)
# smtp    = really send (server); Resend settings below
MAIL_BACKEND=console
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=<resend-api-key>
SMTP_FROM="Bakost Numismatics <noreply@<verified-domain>>"
SMTP_STARTTLS=true

# --- Google sign-in ---
# Create a Web application OAuth client in Google Cloud Console.
# Authorized redirect URI: https://<domain>/api/v1/auth/google/callback
# Leave both empty to hide Google sign-in in this environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- LLM translation of user-typed names (app/services/translation.py) ---
# Background translation of personal catalog titles and storage locations.
# Empty disables it (names stay as typed); tests never reach the API.
ANTHROPIC_API_KEY=<anthropic-api-key>


# Background job reporting and the private admin Telegram bot.
JOB_REPORT_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Public support bot. Keep its token separate from the private admin bot.
SUPPORT_TELEGRAM_BOT_TOKEN=
SUPPORT_TELEGRAM_BOT_USERNAME=
SUPPORT_TELEGRAM_WEBHOOK_SECRET=
# One-time group setup password; replace it after /setup succeeds.
SUPPORT_TELEGRAM_SETUP_SECRET=
