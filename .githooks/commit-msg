#!/bin/sh
# Blocks commits that change mapped code without its document (docs/README.md,
# "How docs are kept in step"). Enable once per clone:
#   git config core.hooksPath .githooks
if ! command -v python3 >/dev/null 2>&1; then
    echo "commit-msg: python3 not found, docs check skipped" >&2
    exit 0
fi
exec python3 "$(git rev-parse --show-toplevel)/tools/docs_check.py" commit-msg "$1"
