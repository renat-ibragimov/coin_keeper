# HTTPS with automatic certificates (docs/10-infra.md).
{$DOMAIN} {
	handle /api/* {
		# One megabyte over the 12 MB an image upload may carry
		# (MAX_SOURCE_BYTES), so an oversized body is refused at the edge
		# rather than streamed into the API to be measured there. Every other
		# endpoint takes JSON and is nowhere near this.
		request_body {
			max_size 13MB
		}
		reverse_proxy api:8000
	}

	# S3_PUBLIC_ENDPOINT signs URLs as https://<domain>/media/<bucket>/<key>;
	# handle_path strips /media so MinIO sees its own path-style /<bucket>/<key>
	# (docs/06-media-storage.md). The Host header passes through unchanged,
	# which is what the presigned signature was computed against.
	handle_path /media/* {
		reverse_proxy minio:9000
	}

	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}

	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
